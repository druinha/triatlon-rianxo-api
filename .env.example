# Copia este ficheiro a .env e cambia os valores
DATABASE_URL=mysql+aiomysql://triatlon:CAMBIA_ESTE_CONTRASINAL@127.0.0.1:3306/triatlon_rianxo
# URL pública da web (para xerar as ligazóns de invitación)
SITE_URL=https://triatlon.pdcgsolutions.com
# Orixes permitidas para peticións POST (protección CSRF), separadas por comas
ALLOWED_ORIGINS=https://triatlon.pdcgsolutions.com
# En local (http) pon false
COOKIE_SECURE=true
# Só en local: CORS_ORIGINS=http://localhost:4321  (en produción déixao sen poñer)
# Cartafol das fotos de perfil (fóra de /var/www: só as serve a API a membros con sesión)
MEDIA_DIR=/var/lib/triatlon-api/media
