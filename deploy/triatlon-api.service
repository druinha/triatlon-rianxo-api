# /etc/systemd/system/triatlon-api.service
[Unit]
Description=Triatlón Rianxo API (FastAPI)
After=network.target mysql.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/opt/triatlon-api
EnvironmentFile=/opt/triatlon-api/.env
# Só escoita en localhost: entra a través de Caddy
ExecStart=/opt/triatlon-api/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
