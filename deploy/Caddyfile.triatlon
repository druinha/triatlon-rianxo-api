# Substitúe o bloque triatlon.pdcgsolutions.com do /etc/caddy/Caddyfile por este
triatlon.pdcgsolutions.com {
	encode zstd gzip
	# Vista previa: que Google non a indexe
	header X-Robots-Tag "noindex, nofollow"

	# API (FastAPI no porto 8001)
	handle /api/* {
		reverse_proxy 127.0.0.1:8001
	}

	# Web estática (Astro)
	handle {
		root * /var/www/triatlon-rianxo/dist
		@assets path /_astro/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle_errors {
		root * /var/www/triatlon-rianxo/dist
		rewrite * /404.html
		file_server
	}
}
